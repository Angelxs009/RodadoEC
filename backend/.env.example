DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_db?schema=public"
NODE_ENV=development
PORT=3000

# Login del backoffice de Admin (/admin/auth/login). Cambia estos valores en
# producción — si no se setean, se usan los defaults de desarrollo (inseguros).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=rodadoec2026
ADMIN_JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Login de clientes (/auth/register, /auth/login). Render la genera sola en
# producción (render.yaml). Para desarrollo local, cualquier valor sirve.
CUSTOMER_JWT_SECRET=cambia-esto-tambien-por-otro-secreto-aleatorio

# Producción (Render la inyecta sola vía render.yaml, no hace falta setearla a mano):
# CORS_ORIGINS=https://rodadoec.vercel.app
