{
  "name": "rodadoec-services",
  "version": "1.1.0",
  "description": "RodadoEc (dominio Autos del Booking Prototipo): API Gateway + microservicios Catálogo, Reservas, Pagos e Identidad",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build gateway && nest build catalog && nest build booking && nest build payments && nest build identity",
    "build:gateway": "nest build gateway",
    "build:catalog": "nest build catalog",
    "build:booking": "nest build booking",
    "build:payments": "nest build payments",
    "build:identity": "nest build identity",
    "start:gateway": "node dist/apps/gateway/main",
    "start:catalog": "node dist/apps/catalog/main",
    "start:booking": "node dist/apps/booking/main",
    "start:payments": "node dist/apps/payments/main",
    "start:identity": "node dist/apps/identity/main",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "check:contracts": "node ../contracts/check-compat.js",
    "build:all": "nest build all",
    "start:all": "node dist/apps/all/apps/all/src/main.js"
  },
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@apollo/subgraph": "^2.7.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.10",
    "@nestjs/apollo": "^12.1.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/microservices": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "amqplib": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "graphql": "^16.8.0",
    "js-yaml": "^4.1.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  }
}
