{
  "rootDir": "..",
  "testRegex": "test/unit/.*\\.spec\\.ts$",
  "moduleNameMapper": {
    "^@autos/common$": "<rootDir>/libs/common/src",
    "^@autos/common/(.*)$": "<rootDir>/libs/common/src/$1",
    "^@nestjs/jwt$": "<rootDir>/test/unit/jwt-stub.js"
  },
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "target": "ES2021",
          "module": "commonjs",
          "esModuleInterop": true,
          "experimentalDecorators": true,
          "emitDecoratorMetadata": true,
          "types": [
            "jest",
            "node"
          ]
        },
        "diagnostics": false
      }
    ]
  },
  "testEnvironment": "node",
  "collectCoverageFrom": [
    "libs/common/src/availability.ts",
    "libs/common/src/pricing.ts",
    "libs/common/src/ttl-cache.ts",
    "libs/common/src/problem.ts",
    "apps/payments/src/payments.service.ts",
    "apps/identity/src/password.service.ts"
  ]
}